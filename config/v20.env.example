# The normal main/V16 container reuses DB_*, Tushare, and FEISHU_* settings.
# Its required MEWS inputs are the published URL and an API key. Set
# V20_EMBEDDED_ENABLED only for an explicit emergency/maintenance opt-out:
# V20_EMBEDDED_ENABLED=false
# Finalized MEWS v2 curve endpoint. V20 reads it once after the 09:10 release,
# validates the previous-session observation, and caches an immutable snapshot.
# If the observation is missing, V20 calls the same service's production refresh
# endpoint and reads again. The refresh URL is derived by replacing
# /margin-risk-curve with /margin-risk-refresh; set V20_MEWS_REFRESH_URL only
# when the service uses a non-standard route. TRADING_API_KEY is used by default;
# V20_MEWS_API_KEY is an optional dedicated override carrying the same authority.
V20_MEWS_SOURCE_URL=http://mews-service:8000/api/trading/margin-risk-curve?days=5
# V20_MEWS_REFRESH_URL=http://mews-service:8000/api/trading/margin-risk-refresh
# V20_MEWS_API_KEY=replace-with-mews-service-trading-api-key
TRADING_API_KEY=replace-with-main-trading-api-key

# Everything below configures the optional isolated/dedicated V20 runtime.
# Supplying any explicit activation variable makes the legacy app use the
# strict loader instead of implicit embedded activation.
V20_ENABLED=false
V20_MODE=forward_shadow
V20_ALLOW_PRODUCTION_PUSH=false
V20_HOST=0.0.0.0
V20_PORT=8000

# Formal V20 uses `python scripts/v20_main.py` or Docker target `v20`.
# WEB_ENABLED is only needed when forward shadow is intentionally hosted by the
# legacy platform process; the dedicated V20 host ignores it.
WEB_ENABLED=true

# V20 scan resources read stock fundamentals and Tushare market data. The
# dedicated host does not start the platform state manager or trading services.
DB_HOST=postgres.example.internal
DB_PORT=5432
DB_NAME=strategy
DB_USER=platform-runtime-role
DB_PASSWORD=replace-with-secret-manager-value
DB_SSLMODE=verify-full
DB_SSLROOTCERT=/run/secrets/fundamentals-postgres-ca.pem
DB_SSLROOTCERT_SHA256=replace-with-reviewed-lowercase-sha256
DB_CONNECT_TIMEOUT_SECONDS=5
DB_COMMAND_TIMEOUT_SECONDS=15
TUSHARE_TOKEN=replace-with-tushare-token

# Do not inject broker/iQuant credentials into the dedicated V20 container.

# Dedicated PostgreSQL writer for the V20 decision ledger and durable outbox.
# This role must not have broker, account, order, holding, or fill permissions.
V20_DB_HOST=postgres.example.internal
V20_DB_PORT=5432
V20_DB_NAME=strategy
V20_DB_USER=v20_writer
V20_DB_PASSWORD=replace-with-secret-manager-value
V20_DB_SSLMODE=verify-full
V20_DB_SSLROOTCERT=/run/secrets/v20-postgres-ca.pem
V20_DB_SSLROOTCERT_SHA256=replace-with-reviewed-lowercase-sha256
V20_DB_CONNECT_TIMEOUT_SECONDS=5
V20_DB_COMMAND_TIMEOUT_SECONDS=15

# Evidence writes and status reads use two independent secrets (at least 32
# chars and different from each other).
# Headers: X-V20-API-Key and X-V20-Status-Key respectively.
# POST /api/v20/trigger-scan intentionally has no application-layer API key for
# now and needs no header by default. An optional caller-generated
# Idempotency-Key makes timeout retries idempotent; without it, every call gets
# a new manual-<uuid> and queues a new non-actionable receipt. HTTP 202 is not
# proof of delivery.
V20_INGEST_API_KEY=replace-with-a-long-random-ingest-secret
V20_STATUS_API_KEY=replace-with-a-different-long-random-status-secret

# Forward-shadow Feishu route. Keep it isolated from the formal decision chat.
V20_SHADOW_FEISHU_BOT_URL=https://feishu-relay.example.internal
V20_SHADOW_FEISHU_APP_ID=replace-with-shadow-app-id
V20_SHADOW_FEISHU_APP_SECRET=replace-with-shadow-app-secret
V20_SHADOW_FEISHU_CHAT_ID=replace-with-shadow-chat-id

# Formal V20 decision/exit route. These are intentionally NOT named
# V20_FORMAL_FEISHU_*; the runtime prefix is V20_FEISHU_*.
V20_FEISHU_BOT_URL=https://feishu-relay.example.internal
V20_FEISHU_APP_ID=replace-with-formal-app-id
V20_FEISHU_APP_SECRET=replace-with-formal-app-secret
V20_FEISHU_CHAT_ID=replace-with-formal-chat-id
