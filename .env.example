# Environment Variables for Production Deployment
# Copy this file to .env and fill in your values

# iFinD HTTP API 凭证
# 从 iFinD Windows 客户端获取: 工具 -> refresh_token 查询/更新
IFIND_REFRESH_TOKEN=your_refresh_token_here

# Set false to pause only V16 automatic morning selection. Keeps V22 running.
V16_AUTO_SCAN_ENABLED=true
