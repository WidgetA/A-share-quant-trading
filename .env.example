# Environment Variables for Production Deployment
# Copy this file to .env and fill in your values

# iFinD HTTP API 凭证
# 从 iFinD Windows 客户端获取: 工具 -> refresh_token 查询/更新
IFIND_REFRESH_TOKEN=your_refresh_token_here

# Tushare Pro（不要提交真实Token）
TUSHARE_TOKEN=your_tushare_pro_token_here
# MEWS生产摄取的可选限流与重试参数
MARGIN_RISK_REQUEST_INTERVAL_SECONDS=0.25
MARGIN_RISK_MAX_RETRIES=4
